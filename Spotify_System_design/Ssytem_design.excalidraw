      "boundElements": [],
      "updated": 1790214705542,
      "link": null,
      "locked": false,
      "text": "Caching means storing frequently accessed\ndata in a faster temporary storage so that\nfuture requests can be served quickly\nwithout repeatedly accessing the database.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caching means storing frequently accessed data in a faster temporary storage so that future requests can be served quickly without repeatedly accessing the database.",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1790214701787,
      "labelPosition": null,
      "baseFontSize": null
    },
